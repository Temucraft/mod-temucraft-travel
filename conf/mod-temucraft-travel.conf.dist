[worldserver]

########################################
# mod-temucraft-travel
########################################
#
#    Temucraft.Travel.Enable
#        Description: Repair kits and the Cozy Sleeping Bag.
#        Default:     1

Temucraft.Travel.Enable = 1

#
#    Temucraft.Travel.RepairKits
#        Description: Which items repair equipped gear: "item:percent:maxItemLevel,..." (maxItemLevel 0 = any).
#                     The items need ScriptName item_temucraft_repair_kit (data/sql does that for its three kits).
#        Default:     "601621:25:100,601622:50:200,601623:100:0"

Temucraft.Travel.RepairKits = "601621:25:100,601622:50:200,601623:100:0"

#
#    Temucraft.Travel.SleepingBag.Entry
#        Description: The bedroll gameobject the Cozy Sleeping Bag lays down.
#        Default:     601620

Temucraft.Travel.SleepingBag.Entry = 601620

#
#    Temucraft.Travel.SleepingBag.Duration
#        Description: Seconds the bedroll stays.
#        Default:     600

Temucraft.Travel.SleepingBag.Duration = 600

#
#    Temucraft.Travel.SleepingBag.RestedPerMinute
#        Description: Rested experience per minute of sleep, in percent of the experience for your next level (the
#                     usual rested cap still applies). 0 = none.
#        Default:     1

Temucraft.Travel.SleepingBag.RestedPerMinute = 1

#
#    Temucraft.Travel.Hearthstone.Enable
#        Description: Hearthstone cooldown as each player chooses (at any innkeeper, or .temucraft hearthstone <minutes>).
#                     Applies to every spell sharing the hearthstone's cooldown.
#        Default:     1
#
#    Temucraft.Travel.Hearthstone.Choices
#        Description: The cooldowns offered, in minutes (0 = no cooldown).
#        Default:     "0,15,30,45,60"
#
#    Temucraft.Travel.Hearthstone.Default
#        Description: Cooldown in minutes for players who never chose (30 = the game's own).
#        Default:     30
#
#    Temucraft.Travel.Hearthstone.AllowChoice
#        Description: Players may choose. 0 = Default applies to everyone.
#        Default:     1

Temucraft.Travel.Hearthstone.Enable = 1
Temucraft.Travel.Hearthstone.Choices = "0,15,30,45,60"
Temucraft.Travel.Hearthstone.Default = 30
Temucraft.Travel.Hearthstone.AllowChoice = 1

#
#    Temucraft.Travel.SafeLanding
#        Description: A player who falls through the world (under the map) is put back on the last ground they
#                     stood on instead of falling into the void and dying. Open world only.
#        Default:     1

Temucraft.Travel.SafeLanding = 1

#
#    Temucraft.Travel.SafeLanding.MinFallTime
#    Temucraft.Travel.SafeLanding.MinDrop
#        Description: A fall only counts once it has lasted this long (milliseconds) and gone this far down (yards).
#                     Jumps and short drops, in caves too, never put you back.
#        Default:     2000, 30

Temucraft.Travel.SafeLanding.MinFallTime = 2000
Temucraft.Travel.SafeLanding.MinDrop = 30

#
#    Temucraft.Travel.SwiftFlights
#        Description: Flight paths go faster for players with a flight speed bonus, on top of the server's
#                     Rate.TaxiFlightSpeed. Spells: "spell:percent" pairs counted while the player knows the spell or
#                     has its aura (117983 = guild perk Ride Like the Wind). Other modules add theirs (mod-temucraft-legacy
#                     Swift Flights). Max caps the total bonus.
#        Default:     1, "117983:25", 100

Temucraft.Travel.SwiftFlights = 1
Temucraft.Travel.SwiftFlights.Spells = "117983:25"
Temucraft.Travel.SwiftFlights.Max = 100

#
#    Temucraft.Travel.TaxiLeavesForm
#        Description: At a flight master while shapeshifted (or mounted), the menu offers "Leave <form> and fly" with a
#                     confirmation, then removes the form (or dismounts) and opens the flight map, instead of the
#                     "can't do that while shapeshifted" error.
#        Default:     1

Temucraft.Travel.TaxiLeavesForm = 1

#
#    Temucraft.Travel.FlightFormFare
#        Description: Druids in Flight Form get "Fly in Flight Form" at flight masters: the flight costs this % of the
#                     price and they're back in Flight Form on landing (100 = no such option).
#        Default:     50

Temucraft.Travel.FlightFormFare = 50

#
#    Temucraft.Travel.Atlas.Enable
#        Description: Skyreader's Atlas items: learn every flight path of your faction on one continent.
#        Default:     1

Temucraft.Travel.Atlas.Enable = 1

#
#    Temucraft.Travel.Atlas.FirstItem
#        Description: Item entry of the first atlas (Eastern Kingdoms); the next three are Kalimdor, Outland, Northrend.
#        Default:     610146

Temucraft.Travel.Atlas.FirstItem = 610146

#
#    Temucraft.Travel.Waygate.Enable
#        Description: Hearthbound Waygate, Fel Waygate and Wayfarer's Beacon items. A waygate places a portal that takes
#                     everyone who clicks it to their own hearthstone spot; the beacon places a beam of light.
#        Default:     1

Temucraft.Travel.Waygate.Enable = 1

#
#    Temucraft.Travel.Waygate.Seconds
#        Description: How long a waygate portal stays open, in seconds. Its cooldown is the item's spellcooldown_1.
#        Default:     60

Temucraft.Travel.Waygate.Seconds = 60

#
#    Temucraft.Travel.Beacon.Seconds
#        Description: How long the Wayfarer's Beacon beam stays, in seconds.
#        Default:     300

Temucraft.Travel.Beacon.Seconds = 300

#
#    Temucraft.Travel.Skyriding.Enable
#        Description: Skyriding (prototype): with .temucraft skyriding on, a flying mount gains speed when diving and
#                     loses it when climbing, and Vigor pays for .temucraft skyriding surge (a burst of speed) and
#                     .temucraft skyriding ascent (a launch upwards). Done on the server, so it feels stepped with lag.
#                     The command is admin only until linked to the player roles (db-auth SQL, permission 103354).
#        Default:     1

Temucraft.Travel.Skyriding.Enable = 1

#
#    Temucraft.Travel.Skyriding.Dive
#    Temucraft.Travel.Skyriding.Drag
#    Temucraft.Travel.Skyriding.MinSpeed
#    Temucraft.Travel.Skyriding.MaxSpeed
#        Description: Dive: speed gained per second in a straight dive (as a flight speed rate, 1 = run speed). Drag:
#                     share of the difference to the mount's own speed that goes away per second. MinSpeed and
#                     MaxSpeed: limits, as a share of the mount's own speed.
#        Default:     1.2, 0.25, 0.6, 2.2

Temucraft.Travel.Skyriding.Dive = 1.2
Temucraft.Travel.Skyriding.Drag = 0.25
Temucraft.Travel.Skyriding.MinSpeed = 0.6
Temucraft.Travel.Skyriding.MaxSpeed = 2.2

#
#    Temucraft.Travel.Skyriding.Vigor
#    Temucraft.Travel.Skyriding.VigorRegen
#    Temucraft.Travel.Skyriding.ThrillRegen
#    Temucraft.Travel.Skyriding.Surge
#        Description: Vigor points; seconds per point while mounted; seconds per point while flying faster than 1.5x
#                     the mount's speed; how much Surge Forward adds (share of the mount's speed).
#        Default:     6, 15, 5, 0.6

Temucraft.Travel.Skyriding.Vigor = 6
Temucraft.Travel.Skyriding.VigorRegen = 15
Temucraft.Travel.Skyriding.ThrillRegen = 5
Temucraft.Travel.Skyriding.Surge = 0.6

#
#    Temucraft.Travel.Flight.FlyThrough
#        Description: Retail-style flight paths: at a flight master you can fly to any flight point you know on this
#                     continent, through the flight points of your faction you don't know yet. Those show on the
#                     flight map as small route dots (with the Temucraft client patch) and can't be picked; flying
#                     through one does not teach it. Needs the core hooks OnPlayerSendTaxiMenu and
#                     OnPlayerCanFlyThroughTaxiNode.
#        Default:     1

Temucraft.Travel.Flight.FlyThrough = 1

#
#    Temucraft.Travel.Flight.StartingNodes
#        Description: Every character knows its race's capital flight point and its faction's main capital
#                     (StartingNodes.Alliance / .Horde), given at its first login.
#        Default:     1
#
#    Temucraft.Travel.Flight.StartingNodes.Existing
#        Description: Characters made before this was on get them too, once, at their next login.
#        Default:     1
#
#    Temucraft.Travel.Flight.StartingNodes.Alliance
#    Temucraft.Travel.Flight.StartingNodes.Horde
#        Description: The faction's main capital (TaxiNodes.dbc id). 2 = Stormwind, 23 = Orgrimmar.
#        Default:     2, 23
#
#    Temucraft.Travel.Flight.StartingNodes.Races
#        Description: "race:node,..." the race's own capital (a race may be listed more than once). Races not listed
#                     (the allied and custom races: none of their home cities has a flight point in our data) get
#                     only their faction's capital. 2 Stormwind, 6 Ironforge, 27 Rut'theran Village (Darnassus),
#                     94 The Exodar, 23 Orgrimmar, 11 Undercity, 22 Thunder Bluff, 82 Silvermoon City.
#        Default:     "1:2,3:6,4:27,5:11,6:22,7:6,10:82,11:94"

Temucraft.Travel.Flight.StartingNodes = 1
Temucraft.Travel.Flight.StartingNodes.Existing = 1
Temucraft.Travel.Flight.StartingNodes.Alliance = 2
Temucraft.Travel.Flight.StartingNodes.Horde = 23
Temucraft.Travel.Flight.StartingNodes.Races = "1:2,3:6,4:27,5:11,6:22,7:6,10:82,11:94"
